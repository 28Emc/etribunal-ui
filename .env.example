# eTribunal UI — variables de entorno (copiar a .env)
#
# Este frontend consume la API de eTribunal a través del API Gateway (BFF) Spring.
# VITE_API_URL debe apuntar al gateway, NUNCA a los servicios internos ni al legado:
#   gateway  -> http://localhost:8080/api   (Spring, implementación actual)
#   legacy   -> http://localhost:3001/api   (NestJS, ya descontinuado)

VITE_API_URL=http://localhost:8080/api
VITE_APP_URL=http://localhost:3000
VITE_APP_NAME=eTribunal
VITE_ENABLE_TRANSLATIONS=false